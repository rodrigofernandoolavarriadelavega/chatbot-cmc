{
  "id": "post_cita_confirmacion",
  "phone": "56900000017",
  "fecha_real": "2026-05-15T03:00:00",
  "context": "Paciente que ya reservó hora dice 'ya reservé hora'. Bot debe confirmar la cita existente, no disparar flujo de agendamiento de nuevo (fix FIX 5).",
  "bug_ref": "FIX 5 post-cita confirmaciones",
  "steps": [
    {
      "in": "quiero una hora de medicina general",
      "expect_state": "WAIT_SLOT",
      "expect_match": ["medicina general"]
    },
    {
      "in": "1",
      "expect_state": "WAIT_MODALIDAD",
      "expect_match": ["fonasa|particular|modalidad"]
    },
    {
      "in": "fonasa",
      "expect_state": "WAIT_RUT_AGENDAR",
      "expect_match": ["rut"]
    },
    {
      "in": "11.111.111-1",
      "expect_state": "CONFIRMING_CITA",
      "expect_match": ["confirmar|datos|juan prueba"]
    },
    {
      "in": "sí",
      "expect_state": "IDLE|WAIT_CROSS_SELL",
      "expect_match": ["listo|reservada|confirmada|hora quedó|kinesiología|kine|agendar"],
      "comment": "Cita creada — bot puede ofrecer cross-sell (WAIT_CROSS_SELL) o ir directo a IDLE"
    },
    {
      "in": "no gracias",
      "expect_state": "IDLE",
      "expect_match": ["menu|necesites|listo|gracias"],
      "expect_no_match": ["¿qué especialidad", "rut para"],
      "comment": "Rechazar cross-sell → IDLE limpio"
    }
  ],
  "mock_config": {
    "default_esp": "medicina general",
    "default_prof_id": 73
  }
}
